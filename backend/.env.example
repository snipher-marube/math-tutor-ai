# Copy to .env and adjust. All values are optional; defaults live in config.py.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Seconds to wait for a model reply. Raise it on slow machines.
OLLAMA_TIMEOUT=120
GRADE_LEVEL=2
# Local database file for learners and progress (default: backend/data/math_tutor.db)
# DATABASE_PATH=data/math_tutor.db
# Time zone for counting "different days" when deciding mastery
TIMEZONE=Africa/Nairobi
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]
